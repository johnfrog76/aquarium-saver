# The house rules the sibling repos keep in .prettierrc.json — two spaces, LF,
# utf-8 — written where an editor can read them, since this repo deliberately
# has no formatter in its dependency tree.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 110

# The pages are generated SVG and CSS: long lines are the format, and an editor
# tidying whitespace inside them would show up as a diff against the generators.
[*.html]
max_line_length = off
trim_trailing_whitespace = false
insert_final_newline = false

[*.{yml,yaml}]
indent_size = 2

[*.md]
max_line_length = off
trim_trailing_whitespace = false
